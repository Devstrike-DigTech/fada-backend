# =============================================
# FADA Backend — Environment Variables
# Copy to .env and fill in values
# =============================================

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_VERSION=v1
# Browser origins allowed by CORS for HTTP and WebSocket, comma-separated (e.g. the admin app).
# Leave empty or * in development. Mobile apps are not affected by CORS.
ALLOWED_ORIGINS=
# Optional: team inbox that gets a copy of every new support ticket
SUPPORT_INBOX_EMAIL=

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://fada_user:fada_pass@localhost:5433/fada_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Host ports docker-compose.yml publishes (change both these and the URLs above if the defaults are taken)
POSTGRES_PORT=5433
REDIS_PORT=6379
REDIS_TTL_SECONDS=86400

# JWT
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Rotation: put the OLD secret here when you change the one above (docs/SECURITY.md)
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=

# Hardening
# Proxy hops in front of the app (Railway = 1). Defaults to 1 in production, 0 otherwise.
TRUST_PROXY=
BODY_LIMIT=1mb
RATE_LIMIT_ENABLED=true
REQUEST_LOGGING=true

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Admin Bootstrap (one-time super admin creation)
ADMIN_BOOTSTRAP_SECRET=change-this-to-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/login/google/callback

# Apple Sign-In
APPLE_CLIENT_ID=com.devstrike.fada
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/login/apple/callback

# Paystack
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_

# Flutterwave (fallback provider)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-
FLUTTERWAVE_HASH=

# Payments / Subscriptions
PAYMENT_DEFAULT_PROVIDER=paystack
# Hosted checkout returns here; defaults to {APP_URL}/api/v1/subscriptions/payments/callback
PAYMENT_CALLBACK_URL=
# Optional app deep link the callback redirects to, e.g. fada://payments/result
PAYMENT_SUCCESS_REDIRECT_URL=
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_PLAN_CHANGE_COOLDOWN_DAYS=30
SUBSCRIPTION_IMMEDIATE_CHANGE_THRESHOLD_DAYS=10
SUBSCRIPTION_PENDING_PAYMENT_TTL_HOURS=24

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=fada-storage
CLOUDFLARE_R2_PUBLIC_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Termii SMS
TERMII_API_KEY=
TERMII_API_URL=https://api.ng.termii.com/api
TERMII_SENDER_ID=FADA
# generic | dnd (dnd for transactional SMS to numbers on the NCC do-not-disturb list)
TERMII_CHANNEL=generic
NOTIFICATIONS_DEFAULT_COUNTRY_CODE=234
# Deep-link scheme the mobile apps handle for notification taps
APP_DEEP_LINK_SCHEME=fada://

# Resend Email
RESEND_API_KEY=re_
EMAIL_FROM=noreply@thefadaapp.com
EMAIL_FROM_NAME=FADA

# External Registries
PCN_REGISTRY_API_URL=
PCN_REGISTRY_API_KEY=
CAC_REGISTRY_API_URL=
CAC_REGISTRY_API_KEY=
NAFDAC_REGISTRY_URL=

# Rate Limits
GUEST_SEARCH_DAILY_LIMIT=3
GUEST_RESERVATION_DAILY_LIMIT=1
OTP_HOURLY_LIMIT=3
GLOBAL_RATE_LIMIT_PER_MINUTE=100

# Geo Search
GEO_RADIUS_TIERS_KM=2,5,10,20,50

# Reservation
RESERVATION_EXPIRY_HOURS=2

# Low Stock Threshold
DEFAULT_LOW_STOCK_THRESHOLD=5
