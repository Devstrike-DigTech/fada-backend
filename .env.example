# =============================================
# FADA Backend — Environment Variables
# Copy to .env and fill in values
# =============================================

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_VERSION=v1

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://fada_user:fada_pass@localhost:5432/fada_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=86400

# JWT
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Admin Bootstrap (one-time super admin creation)
ADMIN_BOOTSTRAP_SECRET=change-this-to-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/login/google/callback

# Apple Sign-In
APPLE_CLIENT_ID=com.devstrike.fada
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/login/apple/callback

# Paystack
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-
FLUTTERWAVE_HASH=

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=fada-storage
CLOUDFLARE_R2_PUBLIC_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Termii SMS
TERMII_API_KEY=
TERMII_API_URL=https://api.ng.termii.com/api
TERMII_SENDER_ID=FADA

# Resend Email
RESEND_API_KEY=re_
EMAIL_FROM=noreply@thefadaapp.com
EMAIL_FROM_NAME=FADA

# External Registries
PCN_REGISTRY_API_URL=
PCN_REGISTRY_API_KEY=
CAC_REGISTRY_API_URL=
CAC_REGISTRY_API_KEY=
NAFDAC_REGISTRY_URL=

# Rate Limits
GUEST_SEARCH_DAILY_LIMIT=3
GUEST_RESERVATION_DAILY_LIMIT=1
OTP_HOURLY_LIMIT=3
GLOBAL_RATE_LIMIT_PER_MINUTE=100

# Geo Search
GEO_RADIUS_TIERS_KM=2,5,10,20,50

# Reservation
RESERVATION_EXPIRY_HOURS=2

# Low Stock Threshold
DEFAULT_LOW_STOCK_THRESHOLD=5
