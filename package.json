  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest -c test/jest-e2e.config.js --runInBand",
    "lint:check": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e:cov": "jest -c test/jest-e2e.config.js --runInBand --coverage",
    "test:e2e:docker": "bash scripts/test-e2e-docker.sh",
    "seed:build": "tsc -p tsconfig.seed.json",
    "seed:prod": "node dist-seed/prisma/seed.js",
    "migrate:deploy": "prisma migrate deploy",
    "coverage:merge": "node scripts/coverage-merge.js"
  },
