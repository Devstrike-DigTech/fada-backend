// FADA Backend — Prisma Schema
// Database: PostgreSQL + PostGIS
// Generated by: Devstrike Digital Limited

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  customer
  pharmacist
  admin
}

enum OAuthProvider {
  google
  apple
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum PharmacistRoleInPharmacy {
  owner
  operator
  staff
}

enum DayOfWeek {
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

enum DrugType {
  oral
  infusion
  injectable
  antiseptic
  other
}

enum StockStatus {
  in_stock
  low_stock
  out_of_stock
}

enum ReservationStatus {
  pending
  confirmed
  served
  cancelled
  expired
}

enum ReservationItemStatus {
  available
  unavailable
}

enum BillingInterval {
  monthly
  quarterly
  annually
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  trialing
  expired
}

enum PaymentProvider {
  paystack
  flutterwave
}

enum PaymentStatus {
  paid
  failed
  pending
  refunded
}

enum AdCampaignStatus {
  draft
  active
  paused
  expired
  cancelled
}

enum PointsReason {
  registration
  reservation_completed
  drug_added
  ad_launched
  profile_completed
  other
}

enum NotificationType {
  push
  in_app
  sms
  email
}

enum DevicePlatform {
  ios
  android
}

enum SupportTicketStatus {
  pending
  in_review
  resolved
  closed
}

enum FeatureSuggestionStatus {
  submitted
  reviewing
  planned
  shipped
  declined
}

enum SearchType {
  drug
  ailment
  pharmacy
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id               String         @id @default(uuid())
  fadaId           String         @unique @map("fada_id")
  email            String         @unique
  passwordHash     String?        @map("password_hash")
  phone            String?        @unique
  phoneVerified    Boolean        @default(false) @map("phone_verified")
  role             UserRole
  googleId         String?        @unique @map("google_id")
  appleId          String?        @unique @map("apple_id")
  isEmailVerified  Boolean        @default(false) @map("is_email_verified")
  isActive         Boolean        @default(false) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  customerProfile      CustomerProfile?
  pharmacistProfile    PharmacistProfile?
  pcnVerifications     PharmacistProfile[] @relation("PcnVerifiedBy")
  addresses          CustomerAddress[]
  pointsLedger       PointsLedger?
  notifications      NotificationRecord[]
  deviceTokens       DeviceToken[]
  savedDrugs         CustomerSavedDrug[]
  savedPharmacies    CustomerSavedPharmacy[]
  drugLists          CustomerDrugList[]
  searchHistory      CustomerSearchHistory[]
  supportTickets     SupportTicket[]
  featureSuggestions FeatureSuggestion[]
  reservations       Reservation[]          @relation("CustomerReservations")
  servedReservations Reservation[]          @relation("ServedReservations")
  cancelledReservations Reservation[]       @relation("CancelledReservations")

  @@map("users")
}

model CustomerProfile {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  gender       Gender?
  avatarUrl    String?   @map("avatar_url")
  referralCode String?   @unique @map("referral_code")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model PharmacistProfile {
  id               String                   @id @default(uuid())
  userId           String                   @unique @map("user_id")
  firstName        String                   @map("first_name")
  lastName         String                   @map("last_name")
  licenseType      String                   @map("license_type")
  licenseNumber    String                   @map("license_number")
  pcnVerified              Boolean                  @default(false) @map("pcn_verified")
  pcnVerifiedAt            DateTime?                @map("pcn_verified_at")
  pcnVerificationSource    String?                  @map("pcn_verification_source")
  pcnOverrideNote          String?                  @map("pcn_override_note") @db.Text
  pcnVerifiedById          String?                  @map("pcn_verified_by_id")
  pharmacyId               String?                  @map("pharmacy_id")
  roleInPharmacy           PharmacistRoleInPharmacy @default(owner) @map("role_in_pharmacy")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy      Pharmacy? @relation(fields: [pharmacyId], references: [id])
  pcnVerifiedBy User?     @relation("PcnVerifiedBy", fields: [pcnVerifiedById], references: [id])

  @@map("pharmacist_profiles")
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  label       String?
  addressLine String   @map("address_line")
  city        String?
  state       String?
  country     String   @default("Nigeria")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

// ─────────────────────────────────────────────
// PHARMACY & BRANCH
// ─────────────────────────────────────────────

model Pharmacy {
  id               String   @id @default(uuid())
  fadaId           String   @unique @map("fada_id")
  ownerId          String   @map("owner_id")
  name             String
  email            String?
  phone            String?
  description      String?  @db.Text
  cacNumber        String?  @map("cac_number")
  cacVerified      Boolean  @default(false) @map("cac_verified")
  cacVerifiedAt    DateTime? @map("cac_verified_at")
  country          String   @default("Nigeria")
  state            String?
  city             String?
  address          String?
  landmark         String?
  latitude         Float?
  longitude        Float?
  foundedYear      Int?     @map("founded_year")
  isVerified       Boolean  @default(false) @map("is_verified")
  isActive         Boolean  @default(true) @map("is_active")
  reputationLevel  Int      @default(1) @map("reputation_level")
  reputationPoints Int      @default(0) @map("reputation_points")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  branches           Branch[]
  images             PharmacyImage[]
  pharmacistProfiles PharmacistProfile[]
  subscription       PharmacySubscription?
  adCampaigns        AdCampaign[]
  savedByCustomers   CustomerSavedPharmacy[]

  @@map("pharmacies")
}

model Branch {
  id           String   @id @default(uuid())
  pharmacyId   String   @map("pharmacy_id")
  name         String
  address      String?
  landmark     String?
  latitude     Float?
  longitude    Float?
  isHeadBranch Boolean  @default(false) @map("is_head_branch")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pharmacy     Pharmacy               @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  workingHours PharmacyWorkingHours[]
  drugs        Drug[]
  reservations Reservation[]

  @@map("branches")
}

model PharmacyWorkingHours {
  id        String    @id @default(uuid())
  branchId  String    @map("branch_id")
  dayOfWeek DayOfWeek @map("day_of_week")
  openTime  String?   @map("open_time")
  closeTime String?   @map("close_time")
  isClosed  Boolean   @default(false) @map("is_closed")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("pharmacy_working_hours")
}

model PharmacyImage {
  id           String   @id @default(uuid())
  pharmacyId   String   @map("pharmacy_id")
  url          String
  cloudinaryId String?  @map("cloudinary_id")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("pharmacy_images")
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

model DrugCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  iconUrl     String? @map("icon_url")
  description String? @db.Text
  sortOrder   Int     @default(0) @map("sort_order")

  drugs DrugCategoryMap[]

  @@map("drug_categories")
}

model Drug {
  id                 String      @id @default(uuid())
  branchId           String      @map("branch_id")
  nafdacNumber       String?     @map("nafdac_number")
  nafdacVerified     Boolean     @default(false) @map("nafdac_verified")
  name               String
  genericName        String?     @map("generic_name")
  aliasName          String?     @map("alias_name")
  manufacturer       String?
  composition        String?     @db.Text
  drugType           DrugType    @default(oral) @map("drug_type")
  packageType        String?     @map("package_type")
  adultDosage        String?     @map("adult_dosage")
  childrenDosage     String?     @map("children_dosage")
  price              Decimal     @db.Decimal(12, 2)
  currency           String      @default("NGN")
  stockAmount        Int         @default(0) @map("stock_amount")
  stockStatus        StockStatus @default(in_stock) @map("stock_status")
  lowStockThreshold  Int         @default(5) @map("low_stock_threshold")
  isPrescription     Boolean     @default(false) @map("is_prescription")
  expiryDate         DateTime?   @map("expiry_date") @db.Date
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categories            DrugCategoryMap[]
  indications           DrugIndication[]
  contraindications     DrugContraindication[]
  ailmentTags           DrugAilmentTag[]
  images                DrugImage[]
  alternatives          DrugAlternative[]      @relation("DrugAlternatives")
  alternativeOf         DrugAlternative[]      @relation("AlternativeDrugs")
  reservationItems      ReservationItem[]
  adCampaigns           AdCampaign[]
  savedByCustomers      CustomerSavedDrug[]
  drugListItems         CustomerDrugListItem[]

  @@index([branchId])
  @@index([stockStatus])
  @@map("drugs")
}

model DrugCategoryMap {
  drugId     String @map("drug_id")
  categoryId String @map("category_id")

  drug     Drug         @relation(fields: [drugId], references: [id], onDelete: Cascade)
  category DrugCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([drugId, categoryId])
  @@map("drug_category_map")
}

model DrugIndication {
  id         String @id @default(uuid())
  drugId     String @map("drug_id")
  indication String

  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@map("drug_indications")
}

model DrugContraindication {
  id                String @id @default(uuid())
  drugId            String @map("drug_id")
  contraindication  String

  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@map("drug_contraindications")
}

model AilmentTag {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text

  drugs DrugAilmentTag[]

  @@map("ailment_tags")
}

model DrugAilmentTag {
  drugId      String @map("drug_id")
  ailmentTagId String @map("ailment_tag_id")

  drug       Drug       @relation(fields: [drugId], references: [id], onDelete: Cascade)
  ailmentTag AilmentTag @relation(fields: [ailmentTagId], references: [id], onDelete: Cascade)

  @@id([drugId, ailmentTagId])
  @@map("drug_ailment_tags")
}

model DrugAlternative {
  drugId            String @map("drug_id")
  alternativeDrugId String @map("alternative_drug_id")

  drug            Drug @relation("DrugAlternatives", fields: [drugId], references: [id], onDelete: Cascade)
  alternativeDrug Drug @relation("AlternativeDrugs", fields: [alternativeDrugId], references: [id], onDelete: Cascade)

  @@id([drugId, alternativeDrugId])
  @@map("drug_alternatives")
}

model DrugImage {
  id           String   @id @default(uuid())
  drugId       String   @map("drug_id")
  url          String
  cloudinaryId String?  @map("cloudinary_id")
  isPrimary    Boolean  @default(false) @map("is_primary")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@map("drug_images")
}

model NafdacCache {
  id           String   @id @default(uuid())
  nafdacNumber String   @unique @map("nafdac_number")
  name         String?
  manufacturer String?
  composition  String?  @db.Text
  drugType     String?  @map("drug_type")
  rawData      Json?    @map("raw_data")
  cachedAt     DateTime @default(now()) @map("cached_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("nafdac_cache")
}

model BatchUploadJob {
  id         String   @id @default(uuid())
  branchId   String   @map("branch_id")
  fileUrl    String   @map("file_url")
  status     String   @default("queued")
  totalRows  Int      @default(0) @map("total_rows")
  addedCount Int      @default(0) @map("added_count")
  errorCount Int      @default(0) @map("error_count")
  errorRows  Json?    @map("error_rows")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("batch_upload_jobs")
}

// ─────────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────────

model Reservation {
  id                String            @id @default(uuid())
  customerId        String            @map("customer_id")
  branchId          String            @map("branch_id")
  qrCodeUrl         String?           @map("qr_code_url")
  alphanumericCode  String            @unique @map("alphanumeric_code")
  status            ReservationStatus @default(pending)
  notes             String?           @db.Text
  totalAmount       Decimal?          @map("total_amount") @db.Decimal(12, 2)
  expiresAt         DateTime          @map("expires_at")
  servedBy          String?           @map("served_by")
  servedAt          DateTime?         @map("served_at")
  cancelledBy       String?           @map("cancelled_by")
  cancelledAt       DateTime?         @map("cancelled_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  customer         User                       @relation("CustomerReservations", fields: [customerId], references: [id])
  branch           Branch                     @relation(fields: [branchId], references: [id])
  servedByUser     User?                      @relation("ServedReservations", fields: [servedBy], references: [id])
  cancelledByUser  User?                      @relation("CancelledReservations", fields: [cancelledBy], references: [id])
  items            ReservationItem[]
  statusHistory    ReservationStatusHistory[]

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([alphanumericCode])
  @@index([expiresAt])
  @@map("reservations")
}

model ReservationItem {
  id            String                @id @default(uuid())
  reservationId String                @map("reservation_id")
  drugId        String                @map("drug_id")
  quantity      Int                   @default(1)
  unitPrice     Decimal               @map("unit_price") @db.Decimal(12, 2)
  subtotal      Decimal               @db.Decimal(12, 2)
  status        ReservationItemStatus @default(available)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  drug        Drug        @relation(fields: [drugId], references: [id])

  @@map("reservation_items")
}

model ReservationStatusHistory {
  id            String   @id @default(uuid())
  reservationId String   @map("reservation_id")
  fromStatus    String   @map("from_status")
  toStatus      String   @map("to_status")
  changedBy     String?  @map("changed_by")
  note          String?  @db.Text
  changedAt     DateTime @default(now()) @map("changed_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_status_history")
}

// ─────────────────────────────────────────────
// SUBSCRIPTIONS & PAYMENTS
// ─────────────────────────────────────────────

model SubscriptionPlan {
  id               String  @id @default(uuid())
  name             String
  slug             String  @unique
  color            String?
  monthlyPrice     Decimal @map("monthly_price") @db.Decimal(10, 2)
  quarterlyPrice   Decimal? @map("quarterly_price") @db.Decimal(10, 2)
  annualPrice      Decimal? @map("annual_price") @db.Decimal(10, 2)
  inventorySlotLimit Int   @map("inventory_slot_limit")
  branchLimit      Int     @default(1) @map("branch_limit")
  hasAnalytics     Boolean @default(false) @map("has_analytics")
  hasAds           Boolean @default(false) @map("has_ads")
  adDiscountPct    Int     @default(0) @map("ad_discount_pct")
  sortOrder        Int     @default(0) @map("sort_order")
  isActive         Boolean @default(true) @map("is_active")

  subscriptions PharmacySubscription[]

  @@map("subscription_plans")
}

model PharmacySubscription {
  id                       String             @id @default(uuid())
  pharmacyId               String             @unique @map("pharmacy_id")
  planId                   String             @map("plan_id")
  billingInterval          BillingInterval    @map("billing_interval")
  status                   SubscriptionStatus @default(trialing)
  paystackSubscriptionCode String?            @map("paystack_subscription_code")
  paystackCustomerCode     String?            @map("paystack_customer_code")
  flutterwavePlanId        String?            @map("flutterwave_plan_id")
  currentPeriodStart       DateTime           @map("current_period_start")
  currentPeriodEnd         DateTime           @map("current_period_end")
  cancelledAt              DateTime?          @map("cancelled_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  pharmacy       Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  billingRecords BillingRecord[]

  @@index([pharmacyId, status])
  @@map("pharmacy_subscriptions")
}

model BillingRecord {
  id               String          @id @default(uuid())
  subscriptionId   String          @map("subscription_id")
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("NGN")
  paymentProvider  PaymentProvider @map("payment_provider")
  providerReference String?        @map("provider_reference")
  status           PaymentStatus   @default(pending)
  paidAt           DateTime?       @map("paid_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  subscription PharmacySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_records")
}

// ─────────────────────────────────────────────
// ADS & PROMOTIONS
// ─────────────────────────────────────────────

model AdCampaign {
  id             String           @id @default(uuid())
  pharmacyId     String           @map("pharmacy_id")
  drugId         String?          @map("drug_id")
  title          String
  description    String?          @db.Text
  creativeUrl    String?          @map("creative_url")
  targetRadiusKm Int              @default(10) @map("target_radius_km")
  targetState    String?          @map("target_state")
  timeslotStart  DateTime         @map("timeslot_start")
  timeslotEnd    DateTime         @map("timeslot_end")
  budgetNgn      Decimal?         @map("budget_ngn") @db.Decimal(10, 2)
  status         AdCampaignStatus @default(draft)
  impressionsCount Int            @default(0) @map("impressions_count")
  clicksCount    Int              @default(0) @map("clicks_count")
  rating         Decimal?         @db.Decimal(3, 2)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  drug     Drug?    @relation(fields: [drugId], references: [id], onDelete: SetNull)

  @@index([status, timeslotEnd])
  @@map("ad_campaigns")
}

// ─────────────────────────────────────────────
// POINTS & REPUTATION
// ─────────────────────────────────────────────

model PointsLedger {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  balance       Int      @default(0)
  lifetimeEarned Int     @default(0) @map("lifetime_earned")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointsTransaction[]

  @@map("points_ledgers")
}

model PointsTransaction {
  id        String       @id @default(uuid())
  ledgerId  String       @map("ledger_id")
  delta     Int
  reason    PointsReason
  referenceId String?    @map("reference_id")
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  ledger PointsLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@map("points_transactions")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model NotificationRecord {
  id             String           @id @default(uuid())
  recipientId    String           @map("recipient_id")
  title          String
  body           String           @db.Text
  type           NotificationType
  channelPayload Json?            @map("channel_payload")
  isRead         Boolean          @default(false) @map("is_read")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@map("notification_records")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ─────────────────────────────────────────────
// CUSTOMER FEATURES
// ─────────────────────────────────────────────

model CustomerSavedDrug {
  customerId String   @map("customer_id")
  drugId     String   @map("drug_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  drug     Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@id([customerId, drugId])
  @@map("customer_saved_drugs")
}

model CustomerSavedPharmacy {
  customerId String   @map("customer_id")
  pharmacyId String   @map("pharmacy_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([customerId, pharmacyId])
  @@map("customer_saved_pharmacies")
}

model CustomerDrugList {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CustomerDrugListItem[]

  @@map("customer_drug_lists")
}

model CustomerDrugListItem {
  id       String   @id @default(uuid())
  listId   String   @map("list_id")
  drugId   String   @map("drug_id")
  quantity Int      @default(1)
  addedAt  DateTime @default(now()) @map("added_at")

  list CustomerDrugList @relation(fields: [listId], references: [id], onDelete: Cascade)
  drug Drug             @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@map("customer_drug_list_items")
}

model CustomerSearchHistory {
  id           String     @id @default(uuid())
  customerId   String?    @map("customer_id")
  deviceId     String?    @map("device_id")
  query        String
  searchType   SearchType @map("search_type")
  resultsCount Int        @default(0) @map("results_count")
  radiusUsedKm Int?       @map("radius_used_km")
  createdAt    DateTime   @default(now()) @map("created_at")

  customer User? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("customer_search_history")
}

// ─────────────────────────────────────────────
// SUPPORT & CONTENT
// ─────────────────────────────────────────────

model SupportTicket {
  id            String              @id @default(uuid())
  submitterId   String?             @map("submitter_id")
  complaintType String              @map("complaint_type")
  description   String              @db.Text
  status        SupportTicketStatus @default(pending)
  resolvedAt    DateTime?           @map("resolved_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  submitter User? @relation(fields: [submitterId], references: [id], onDelete: SetNull)

  @@map("support_tickets")
}

model FeatureSuggestion {
  id          String                  @id @default(uuid())
  submitterId String?                 @map("submitter_id")
  title       String
  description String                  @db.Text
  status      FeatureSuggestionStatus @default(submitted)
  createdAt   DateTime                @default(now()) @map("created_at")

  submitter User? @relation(fields: [submitterId], references: [id], onDelete: SetNull)

  @@map("feature_suggestions")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  isEnabled   Boolean  @default(false) @map("is_enabled")
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AppContent {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_content")
}

model GoodCauseProject {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("good_cause_projects")
}

model GoodCauseTestimonial {
  id          String   @id @default(uuid())
  authorName  String   @map("author_name")
  authorAvatar String? @map("author_avatar")
  content     String   @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("good_cause_testimonials")
}
